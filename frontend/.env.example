# Where the backend is running (dev server proxy target). Use ONE of the two; no port is
# hardcoded anywhere in the source, so any port works.
VITE_BACKEND_URL=http://127.0.0.1:<backend-port>
# or: VITE_BACKEND_PORT=<backend-port>   (host defaults to 127.0.0.1; VITE_BACKEND_HOST to change)

# Optional: pin the frontend dev-server port (default: Vite picks a free one).
# VITE_PORT=

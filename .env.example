# PostgreSQL (URL-encode special characters in the password, e.g. "@" -> "%40").
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/truhire
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# REQUIRED. JWT signing key, min 32 chars outside development. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Required - no in-code default. The app will fail to start without these three.
# Docker reaches the host-side DGX SSH tunnel through host.docker.internal.
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# Qdrant Cloud endpoint (the Docker stack does not run a local Qdrant service).
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
OPENSEARCH_URL=http://localhost:9200

VLLM_API_KEY=
VLLM_MODEL=
VLLM_EMBEDDING_MODEL=
VLLM_TIMEOUT=120
DGX_SSH_TARGET=truviq_domain@100.122.195.84
DGX_LOCAL_PORT=8000
SEARCH_CANDIDATE_MULTIPLIER=3
# Keep interactive candidate search fast; enable only for model-based refinement.
SEARCH_LLM_RERANK_ENABLED=false
SEARCH_VECTOR_TIMEOUT=8

QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=truhire_candidate_vectors
QDRANT_DISTANCE=Cosine

OPENSEARCH_INDEX=truhire_candidates_v2

# "local" runs embeddings in-process via fastembed (no API key/external server needed).
# Anything else calls out to the vLLM-compatible endpoint above.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL=
EMBEDDING_DIM=768

# Redis: response/session cache (falls back to in-memory) and the optional arq queue.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# true = run resume ingestion on the arq worker (`arq backend.worker.WorkerSettings`).
USE_ARQ_QUEUE=false

# Optional separate embedding endpoint (when EMBEDDING_PROVIDER is not "local").
EMBEDDING_BASE_URL=
VLLM_EMBEDDING_BASE_URL=
VLLM_EMBEDDING_API_KEY=

OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# Laya decision model (reranking, chat routing, guardrails).
LAYA_ENABLED=false
LAYA_CONFIDENCE_THRESHOLD=0.65
LAYA_RERANK_WEIGHT=0.20

# AI governance: with enforcement on, AI output the guardrails cannot verify (including
# when Laya is unavailable) is replaced by deterministic fallbacks or blocked.
GUARDRAILS_ENFORCE=true
AI_AUDIT_RETENTION_DAYS=365

# Rate limiting (see backend/config.py for defaults if left unset)
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=60/minute

# Storage directories
STORAGE_DIR=./uploads
RESUME_STORAGE_DIR=./uploads/resumes
JD_STORAGE_DIR=./uploads/job_descriptions

# Retention policy (generic, in days; resumes, embeddings/chunks, and JDs expire after this duration)
DATA_RETENTION_DAYS=30
RESUME_RETENTION_DAYS=30
JD_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_HOURS=24

# Outbound candidate email (optional). Leave SMTP_HOST empty and sends are recorded
# as "simulated" in Email History - nothing is actually delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20

# Hiring-company facts the LLM may use when drafting candidate emails (never invented if blank).
COMPANY_NAME=
COMPANY_DESCRIPTION=

# Qdrant memory layout (applied when the collection is created; to change an existing
# collection run POST /api/ingest/reindex?recreate=true). Vectors on disk + int8 in RAM.
QDRANT_ON_DISK=true
QDRANT_QUANTIZATION=true
QDRANT_QUANTILE=0.99
QDRANT_RESCORE_OVERSAMPLING=2.0
INDEX_STATE_TTL=300

# BGE cross-encoder reranker over each shortlisted candidate's best chunk.
# Disabled by default because it is CPU-heavy; enable only when slower refinement is acceptable.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_POOL_CAP=30
RERANKER_WEIGHT=0.30
RERANKER_RETRY_SECONDS=300

# Score calibration (cosine band rescaled to 0-1; no free baseline).
SEMANTIC_WEIGHT=0.60
SKILL_WEIGHT=0.40
BASELINE_SCORE=0.0
SEMANTIC_COSINE_FLOOR=0.40
SEMANTIC_COSINE_CEIL=0.85

APP_ENV=development

# Frontend dev server (read by vite.config.js): where to proxy /api. Must match the uvicorn port.
VITE_BACKEND_PORT=8999
# VITE_BACKEND_URL=http://127.0.0.1:8999   # alternative: full URL, any host
# VITE_PORT=5173                           # optional: pin the dev server port

# Docker host port for the frontend (the container still listens on port 80).
FRONTEND_PORT=3999

# Reviewer roles: comma-separated emails that register as admin (everyone else registers as recruiter).
# BOOTSTRAP_ADMIN_EMAILS=lead@company.com
# Shared review comments are limited to this many characters.
# COMMENT_MAX_CHARS=2000

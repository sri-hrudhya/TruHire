# TruHire Environment Configuration

# Core App
APP_NAME=TruHire
APP_ENV=development
DEBUG=True

# Database (SQLite default, swap to Postgres via DATABASE_URL)
DATABASE_URL=sqlite:///./truhire.db
# DATABASE_URL=postgresql://user:password@localhost:5432/truhire

# JWT Authentication
SECRET_KEY=truhire_super_secret_jwt_key_change_in_production_9f83a2c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Google Gemini Integration
# GEMINI_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# OpenSearch Vector Search
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=truhire_candidates

# Bulk Ingestion
INGEST_BATCH_SIZE=50
MAX_UPLOAD_MB=15
STORAGE_DIR=./uploads

# Search & Ranking Constraints
SEARCH_TOP_N=20
SEARCH_MAX_TOP_N=100

# Hybrid Scoring Weights
SEMANTIC_WEIGHT=0.45
SKILL_WEIGHT=0.35
BASELINE_SCORE=0.20
EXPERIENCE_PENALTY=0.10
EDUCATION_PENALTY=0.05

# Analytics & Caching
ANALYTICS_TOP_SKILLS=20
CACHE_TTL_QUERY=300
CACHE_TTL_CHAT=600

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
